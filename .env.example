# Server-side credentials. Copy to .env; never put these keys in dist/.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_TEXT_MODEL=gpt-5.6-terra
# Must support the requested 2048x1024 image dimensions.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
PORT=3000

# Instagram sign-in (Facebook Login for a professional Instagram account).
# Register the exact callback as a Valid OAuth Redirect URI in your Meta app:
# http://localhost:3000/api/instagram/callback (local), or your HTTPS origin.
# Requires instagram_basic, pages_show_list, pages_read_engagement, and
# Instagram Public Content Access. App review may be needed for other users.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v25.0

# Optional legacy fallback: server-configured Instagram hashtag account.
# Leave blank to use each browser's signed-in account instead.
# The fallback uses a Facebook User token with tasks on the connected Page.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Set only behind an authenticated HTTPS reverse proxy. Server binds localhost.
# PUBLIC_ORIGIN=https://your-app.example
