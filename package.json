    "verify:scout": "node scripts/verify-scout.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "verify:location": "node scripts/verify-location-journey.mjs",
    "verify:live-api": "node scripts/verify-live-api.mjs",
    "build:studio": "esbuild src/customise.js --bundle --minify --format=esm --external:./crow-design.js --outfile=dist/customise.js",
    "verify:studio": "node scripts/verify-studio.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:chat-interface": "node scripts/verify-chat-interface.mjs",
    "verify:discovery": "node scripts/verify-discovery.mjs",
    "verify:scene-author": "node scripts/verify-scene-author.mjs",
    "verify:flight-controls": "node scripts/verify-flight-controls.mjs",
    "verify:vote": "node scripts/verify-vote.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "build": "node scripts/build-sites.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "0.28.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.61.1",
    "three": "0.186.0"
  }
