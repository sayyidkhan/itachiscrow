{
  "name": "itachiscrow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/server.test.mjs scripts/verify-live.mjs scripts/verify-location.mjs && node scripts/verify-map-contract.mjs",
    "verify:scout": "node scripts/verify-scout.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "verify:location": "node scripts/verify-location-journey.mjs",
    "verify:live-api": "node scripts/verify-live-api.mjs",
    "build:studio": "esbuild src/customise.js --bundle --minify --format=esm --external:./crow-design.js --outfile=dist/customise.js",
    "verify:studio": "node scripts/verify-studio.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "build": "node scripts/build-sites.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.61.1",
    "three": "0.186.0"
  }
}
